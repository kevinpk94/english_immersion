  "id": "1711bfb8-1632-4282-89fa-3d177281a6b3",
  "title": "English in a Minute: On the Ball",
  "audio": "./lessons/1711bfb8-1632-4282-89fa-3d177281a6b3_english-in-a-minute-on-the-ball/audio.mp3",
  "transcript": [
    {
      "startTime": 0,
      "text": "Welcome to English in a Minute."
    },
    {
      "startTime": 7640,
      "text": "Some people use a large ball for exercise."
    },
    {
      "startTime": 12500,
      "text": "Is that what to get on the ball means?"
    },
    {
      "startTime": 15800,
      "text": "Hi, Anna."
    },
    {
      "startTime": 17640,
      "text": "How was your day, Ben?"
    },
    {
      "startTime": 18640,
      "text": "Great."
    },
    {
      "startTime": 19640,
      "text": "Very great."
    },
    {
      "startTime": 20640,
      "text": "Very productive."
    },
    {
      "startTime": 21640,
      "text": "I finished three reports and have only one more to do."
    },
    {
      "startTime": 23800,
      "text": "Wow."
    },
    {
      "startTime": 24800,
      "text": "You are on the ball."
    },
    {
      "startTime": 26720,
      "text": "How did you do them so fast?"
    },
    {
      "startTime": 28960,
      "text": "Coffee."
    },
    {
      "startTime": 29960,
      "text": "Lots of coffee."
    },
    {
      "startTime": 30960,
      "text": "Do you want some?"
    },
    {
      "startTime": 31960,
      "text": "I'll get it."
    },
    {
      "startTime": 32960,
      "text": "I'd love more coffee."
    },
    {
      "startTime": 33960,
      "text": "Thank you."
    },
    {
      "startTime": 34960,
      "text": "Sure, but maybe not that much coffee."
    },
    {
      "startTime": 41320,
      "text": "Someone who is on the ball finishes work quickly and ahead of time."
    },
    {
      "startTime": 47760,
      "text": "We can also say a person should get on the ball when they need to work faster or better."
    },
    {
      "startTime": 55760,
      "text": "And that's English in a Minute."
    }
  ]
}